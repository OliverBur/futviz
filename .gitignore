__pycache__/
*.pyc

# Historia completa de cada club que cachea fetch_elo.py (~40 MB, 130 CSV que
# se vuelven a bajar solos). Lo que sí se versiona es data/<temporada>/elo.csv,
# que es el resumen por temporada que sale de esto.
data/.clubelo/

# HTML crudo que cachea fetch_fbref.py (~25 MB, se vuelve a bajar solo)
data/.fbref_html/

# Artefactos derivados (~47 MB, shots_all_seasons.csv solo pesa 42). Los
# regenera `python code/consolidate_data.py` en segundos a partir de
# data/<temporada>/, que sí se versiona. Vercel no los necesita: solo sirve
# web/dist, no construye nada.
data/processed/

# Lock que deja seleniumbase al bajar chromedriver. Sin prefijo de ruta:
# lo crea en el directorio desde el que se corra el script, no siempre code/
downloaded_files/
.ipynb_checkpoints/
.claude/
BITACORA.md
img/

# Vistas en React (web/react): dependencias de Node. El bundle compilado
# (web/react/build/) SI se versiona: build.py lo copia a dist/react/ sin necesitar Node.
web/react/node_modules/
# Fixtures de la prueba de paridad JS/Python (se regeneran con web/react/test/gen_paridad.py)
web/react/test/fixtures/
