__pycache__/
*.pyc

# Datos: no se versionan. Vienen de fbref, Understat, clubelo y Transfermarkt, y
# sus términos no permiten redistribuirlos; los code/fetch_*.py los vuelven a bajar
# y consolidate_data.py los junta. Vercel no los necesita: solo sirve web/dist, no
# construye nada. Esto cubre también los cachés (data/.clubelo/, .fbref_html/,
# .transfermarkt/, .understat_rosters/) y el respaldo de actualizar.py (.respaldo/).
data/*
# Excepción: los hiperparámetros del xG no son datos de nadie ni un derivado barato
# (los elige code/xg_tuning.py en ~2 h) y xg_modelo.py los lee como entrada.
!data/processed/
data/processed/*
!data/processed/xg_params.json

# Lock que deja seleniumbase al bajar chromedriver. Sin prefijo de ruta:
# lo crea en el directorio desde el que se corra el script, no siempre code/
downloaded_files/
.ipynb_checkpoints/
.claude/
BITACORA.md
img/

# Vistas en React (web/react): dependencias de Node. El bundle compilado
# (web/react/build/) SI se versiona: build.py lo copia a dist/react/ sin necesitar Node.
web/react/node_modules/
# Fixtures de la prueba de paridad JS/Python (se regeneran con web/react/test/gen_paridad.py)
web/react/test/fixtures/
logs/
